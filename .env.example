# ---------------------------------------------------------------------------
# ClustR backend — environment variables
# Copy to `.env` for local dev, or set these on Railway (staging).
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# Core
DJANGO_SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Database (on Railway, reference the Postgres plugin, e.g. ${{Postgres.PGHOST}})
DB_NAME=clustr
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis — Channels (WebSockets), cache, and Celery broker/result backend
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (SMTP) — verification / password-reset mails
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# File storage (S3) — production media uploads. Leave blank in staging if not testing uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Payments — intentionally omitted for staging (no real payments in test env).
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
